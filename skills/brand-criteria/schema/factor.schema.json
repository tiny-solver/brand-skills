{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinysolver.me/schemas/brand-criteria/3/factor.schema.json",
  "title": "기준(factor) — factors/<id>.md 의 JSON 프런트매터",
  "description": "기준 팩 규격 3. 파일은 '---' 줄 · JSON 객체 하나 · '---' 줄 · 마크다운 본문 순서다. 두 모양이 있다: full(기본 팩의 기준 · 커스텀 팩이 add 로 더한 기준)과 override(커스텀 팩이 물려받은 기준의 칸 · 본문을 바꾸는 파일). 이 스키마는 모양만 본다 — id 겹침 · params 허용 범위 · 측정기 존재 같은 의미 검사는 criteria.mjs resolve 가 한다.",
  "oneOf": [{ "$ref": "#/$defs/full" }, { "$ref": "#/$defs/override" }],
  "$defs": {
    "id": { "description": "기준 id — 파일 이름(확장자 뺀 것)과 같다.", "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
    "paramName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
    "line": { "description": "한 줄 글. {{param}} 을 쓸 수 있다.", "type": "string", "minLength": 1, "maxLength": 400 },
    "measureRef": {
      "description": "<측정기 id>@<판> — 판은 정수.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}@[1-9][0-9]{0,2}$"
    },
    "asName": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,15}$" },
    "param": {
      "description": "바꿀 수 있는 값 하나. min · max 는 숫자 값의 허용 범위 — 물려받는 팩이 벗어나면 resolve 가 막는다.",
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": {},
        "min": { "type": "number" },
        "max": { "type": "number" },
        "unit": { "type": "string", "maxLength": 16 },
        "note": { "type": "string", "maxLength": 200 }
      },
      "additionalProperties": false
    },
    "measureCall": {
      "description": "측정기 부르기. with 의 값: 문자열 전체가 \"{{param}}\" 이면 그 param 값(타입 그대로), '$' 로 시작하는 문자열은 대상(direction.json) 경로, '$$' 는 글자 '$'.",
      "type": "object",
      "required": ["use", "as"],
      "properties": { "use": { "$ref": "#/$defs/measureRef" }, "as": { "$ref": "#/$defs/asName" }, "with": { "type": "object" } },
      "additionalProperties": false
    },
    "op": { "enum": [">=", ">", "<=", "<", "=="] },
    "mref": {
      "description": "<as>.<출력 칸> — 측정기 출력의 스칼라 칸.",
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,15}\\.[a-z][a-z0-9_]{0,31}$"
    },
    "cond": {
      "description": "조건식 — all · any · 비교 넷뿐(식 문자열 · eval 없음). 세 값 논리: 비교할 값이 null 이면 그 비교는 null, all 은 false 하나면 false · 아니면 null 하나면 null · 아니면 true, any 는 true 하나면 true · 아니면 null 하나면 null · 아니면 false.",
      "oneOf": [
        {
          "type": "object",
          "required": ["all"],
          "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cond" } } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["any"],
          "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/cond" } } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["m", "op", "p"],
          "properties": { "m": { "$ref": "#/$defs/mref" }, "op": { "$ref": "#/$defs/op" }, "p": { "$ref": "#/$defs/paramName" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["m", "op", "v"],
          "properties": {
            "m": { "$ref": "#/$defs/mref" },
            "op": { "$ref": "#/$defs/op" },
            "v": { "anyOf": [{ "type": "number" }, { "type": "boolean" }, { "type": "string" }, { "type": "null" }] }
          },
          "additionalProperties": false
        }
      ]
    },
    "bandWhen": {
      "type": "object",
      "required": ["score", "when"],
      "properties": { "score": { "enum": [0, 1, 2] }, "when": { "$ref": "#/$defs/cond" } },
      "additionalProperties": false
    },
    "bandElse": {
      "type": "object",
      "required": ["score"],
      "properties": { "score": { "enum": [0, 1, 2] } },
      "additionalProperties": false
    },
    "bands": {
      "description": "위에서부터 처음 맞는 줄의 점수. 마지막 줄은 조건 없이 닫는다. 맞는 줄을 고르는 중에 null 조건을 만나면 그 칸은 null(안 봄).",
      "oneOf": [
        { "type": "array", "prefixItems": [{ "$ref": "#/$defs/bandElse" }], "items": false, "minItems": 1 },
        {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/bandWhen" }, { "$ref": "#/$defs/bandElse" }],
          "items": false,
          "minItems": 2
        },
        {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/bandWhen" }, { "$ref": "#/$defs/bandWhen" }, { "$ref": "#/$defs/bandElse" }],
          "items": false,
          "minItems": 3
        }
      ]
    },
    "decideMeasureGate": {
      "type": "object",
      "required": ["by", "pass"],
      "properties": { "by": { "const": "measure" }, "pass": { "$ref": "#/$defs/cond" } },
      "additionalProperties": false
    },
    "decideMeasureScore": {
      "type": "object",
      "required": ["by", "bands"],
      "properties": { "by": { "const": "measure" }, "bands": { "$ref": "#/$defs/bands" } },
      "additionalProperties": false
    },
    "decideJudge": {
      "type": "object",
      "required": ["by"],
      "properties": {
        "by": { "const": "judge" },
        "trials": { "type": "integer", "minimum": 1, "maximum": 5, "default": 1 },
        "aggregate": {
          "description": "trials > 1 일 때 합치는 법. 문턱 majority(기본 · 동률은 null) · any_false, 점수 median(기본 · 짝수면 낮은 가운데) · min.",
          "enum": ["majority", "any_false", "median", "min"]
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "description": "근거 칸 규칙. template = 측정으로 정한 칸의 근거 글 틀(실행기가 쓴다 — {{param}} · {{as.field}}). must = 판정하는 쪽이 근거에 꼭 넣을 것. pattern = 근거 글이 맞아야 하는 정규식(ECMAScript · 플래그 없음) — 안 맞으면 근거 없음으로 본다. example = 실제 근거 한 줄.",
      "type": "object",
      "properties": {
        "template": { "$ref": "#/$defs/line" },
        "must": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/line" } },
        "pattern": { "type": "string", "minLength": 1, "maxLength": 200 },
        "example": { "type": "string", "minLength": 1, "maxLength": 600 }
      },
      "additionalProperties": false
    },
    "confirm": {
      "description": "판정 뒤 사람이 확인할 것. 권장 여부(셈)는 막지 않고 '사람 확인 남음'으로 보인다.",
      "type": "object",
      "required": ["need"],
      "properties": { "need": { "$ref": "#/$defs/line" } },
      "additionalProperties": false
    },
    "settable": {
      "description": "물려받은 기준에서 바꿀 수 있는 칸 — PACK.md set 의 값, override 파일의 프런트매터. type · measure · decide · evidence 는 못 바꾼다(바꾸려면 disable + 새 id 로 add).",
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "ask": { "$ref": "#/$defs/line" },
        "pass": { "$ref": "#/$defs/line" },
        "two": { "$ref": "#/$defs/line" },
        "one": { "$ref": "#/$defs/line" },
        "zero": { "$ref": "#/$defs/line" },
        "how": { "$ref": "#/$defs/line" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 3 },
        "params": {
          "description": "값만 준다 — {이름: 값}. 이름은 물려받은 기준이 선언한 것만, 숫자는 그 허용 범위(min · max) 안에서만.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/paramName" },
          "minProperties": 1
        },
        "note": {
          "description": "본문 끝에 '## 이 팩에서 덧붙임' 으로 붙는 글 — 기본 팩 본문이 고쳐지면 그대로 따라 받는다.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "confirm": { "$ref": "#/$defs/confirm" }
      }
    },
    "settableStrict": { "type": "object", "$ref": "#/$defs/settable", "minProperties": 1, "unevaluatedProperties": false },
    "override": {
      "description": "커스텀 팩 factors/<물려받은 id>.md — 본문이 있으면 물려받은 본문을 통째로 바꾸고, 칸은 set 처럼 합친다.",
      "type": "object",
      "required": ["id", "override"],
      "properties": { "$schema": { "type": "string" }, "id": { "$ref": "#/$defs/id" }, "override": { "const": true } },
      "$ref": "#/$defs/settable",
      "unevaluatedProperties": false
    },
    "full": {
      "type": "object",
      "required": ["id", "type", "name", "ask", "how", "decide", "evidence"],
      "properties": {
        "$schema": { "type": "string" },
        "id": { "$ref": "#/$defs/id" },
        "type": {
          "description": "gate 문턱(true 통과 · false 막힘 · null 안 봄) · score 점수(0 · 1 · 2 · null 안 봄).",
          "enum": ["gate", "score"]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "ask": { "$ref": "#/$defs/line" },
        "pass": { "$ref": "#/$defs/line" },
        "two": { "$ref": "#/$defs/line" },
        "one": { "$ref": "#/$defs/line" },
        "zero": { "$ref": "#/$defs/line" },
        "how": { "$ref": "#/$defs/line" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 3, "default": 1 },
        "params": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/paramName" },
          "additionalProperties": { "$ref": "#/$defs/param" },
          "maxProperties": 12
        },
        "measure": { "type": "array", "items": { "$ref": "#/$defs/measureCall" }, "maxItems": 6 },
        "decide": {
          "oneOf": [
            { "$ref": "#/$defs/decideMeasureGate" },
            { "$ref": "#/$defs/decideMeasureScore" },
            { "$ref": "#/$defs/decideJudge" }
          ]
        },
        "fallback": {
          "description": "측정기를 못 쓸 때 판정하는 쪽이 할 일. api 측정기를 부르는 기준은 꼭 있어야 한다(resolve 검사). decide.by measure 기준은 이 칸이 있을 때만 측정 못 한 셀을 판정하는 쪽이 채운다 — 없으면 null(안 봄).",
          "$ref": "#/$defs/line"
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "confirm": { "$ref": "#/$defs/confirm" },
        "sources": { "type": "array", "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "gate" } } },
          "then": {
            "required": ["pass"],
            "properties": {
              "decide": {
                "type": "object",
                "not": { "type": "object", "required": ["bands"] },
                "properties": { "aggregate": { "enum": ["majority", "any_false"] } }
              }
            },
            "not": {
              "anyOf": [{ "required": ["two"] }, { "required": ["one"] }, { "required": ["zero"] }, { "required": ["weight"] }]
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "score" } } },
          "then": {
            "required": ["two", "zero"],
            "properties": {
              "decide": {
                "type": "object",
                "not": { "type": "object", "required": ["pass"] },
                "properties": { "aggregate": { "enum": ["median", "min"] } }
              }
            },
            "not": { "required": ["pass"] }
          }
        },
        {
          "if": { "properties": { "decide": { "type": "object", "properties": { "by": { "const": "measure" } } } } },
          "then": {
            "required": ["measure"],
            "properties": {
              "measure": { "type": "array", "minItems": 1 },
              "evidence": { "type": "object", "required": ["template"] }
            }
          }
        },
        {
          "if": { "properties": { "decide": { "type": "object", "properties": { "by": { "const": "judge" } } } } },
          "then": { "properties": { "evidence": { "type": "object", "required": ["must"] } } }
        }
      ]
    }
  }
}
